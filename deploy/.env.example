# Copy to deploy/.env and adjust as needed. docker-compose reads this file.
#
# Recommended path is MANAGED CLOUD stores (no Docker) — see docs/running-locally.md:
#   DATABASE_URL="postgres://…neon.tech/db?sslmode=require"   # Neon (serverless PG)
#   REDIS_URL="rediss://…upstash.io:6379"                     # Upstash (serverless Redis, TLS)
# Point the service at those and run `go run ./cmd/authorize-svc`. The vars below are
# only for the optional local Docker stack.

POSTGRES_USER=authz
POSTGRES_PASSWORD=authz
POSTGRES_DB=authz
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- authorize-svc request auth (TRD §11) ---
# AUTHZ_HMAC_MAX_SKEW=5m     # max clock skew for signed request timestamps
# AUTHZ_NONCE_TTL=10m        # per-key nonce memory (replay window; >= 2x skew)
# AUTHZ_KEY_CACHE_TTL=5m     # Redis cache TTL for key -> org lookups
